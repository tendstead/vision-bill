# ── Vision Bill — environment template ─────────────────────────────────────
# Copy to `.env` (and/or `.env.local`) and fill in the values. Settings use a
# nested `SECTION__FIELD` scheme (see src/vision_bill/config.py). On first run,
# resolved values initialize `/app/config/config.yaml`; process environment
# variables and dotenv values always override that YAML file. In Docker the
# YAML file is stored on the host at `./server_data/config`. The bound directory
# and existing files must be owned by the effective app container UID. Prepared
# bundles use a private volume and a separate literal runtime.env.

# ── API ────────────────────────────────────────────────────────────────────
API__PORT=8080
API__LOG_LEVEL=INFO
# Dedicated OCR controller and receipt worker diagnostics (DEBUG for more detail).
OCR_LOG_LEVEL=INFO

# ── Image / receipt storage ────────────────────────────────────────────────
# Absolute directories. Docker mounts ./server_data/uploads and
# ./server_data/uploads_tmp; for a local run use paths inside your working tree.
# The save directory includes original photos for independent benchmark cases.
IMAGES__SAVE_DIR=/app/uploads/
IMAGES__TMP_DIR=/app/uploads_tmp/
# Bypass requests auto-verification only if current receipt checks are clean.
# Missing data/integrity/review findings still require review; files are never moved.
IMAGES__BYPASS_REVIEW_DEFAULT=false

# ── Background analysis worker ─────────────────────────────────────────────
WORKER__CHECK_INTERVAL_SECONDS=300
WORKER__ATTEMPT_TIMEOUT_SECONDS=600
WORKER__MAX_ATTEMPTS=3
WORKER__RETRY_BACKOFF_SECONDS=[30,60]
WORKER__RETRY_BACKOFF_CAP_SECONDS=300
WORKER__CLAIM_LEASE_SECONDS=900

# Optional canonical OCR selector: a nonblank HTTP(S) endpoint enables OCR;
# an explicitly blank OCR__ENDPOINT initially selects direct vision. With a
# prepared Dedicated OCR profile, an admin can subsequently turn OCR On.
# A nonblank external endpoint stays operator-owned, outside the browser toggle.
# OCR__ENDPOINT=http://your-ocr-service:8082
# Without the canonical endpoint, legacy ENABLED controls the retained URL below.
# A disabled legacy URL is parsed but does not enable OCR. New uploads never use
# image fallback after OCR failure; old fallback keys remain history/replay only.
OCR__ENABLED=false
OCR__REQUIRED=false
OCR__ALLOW_VISION_FALLBACK=false
OCR__SERVICE_URL=http://paddleocr-service:8082
OCR__TIMEOUT_SECONDS=600
# Shared native GPU pairing requires verified Ollama/llama.cpp lifecycle; keep true.
OCR__MANAGE_MODEL_LIFECYCLE=true
# Managed app and standalone processes must share the same lock and journal.
# For separately configured OCR the lock defaults beside VISION_BILL_CONFIG_PATH.
# OCR__COORDINATION_PATH=/app/config/gpu-handoff.lock
# The CUDA/ROCm activation overlays use /coord/gpu-handoff.lock in the original
# project's ocr-coordination volume. Keep that volume for the life of the install.
# Prepare a CUDA/ROCm profile once before using the Settings Dedicated OCR toggle.
# Base Windows Compose alone cannot add native OCR through the browser button.
# The idle controller downloads no models until admin On or explicit startup setup.
# Off selects direct vision and parks OCR. On reuses verified model files.
# Installation and worker startup do not run sample images.
# OCR_ACTIVATION_ON_STARTUP=false
# Set true only with an idle, dedicated LLM endpoint and eager loading disabled.
# OCR_ACTIVATION_CONFIRM_HANDOFF=false
# Attest that the external LLM is quiesced, or select separate-ocr-device.
# OCR_ACTIVATION_MAINTENANCE_INTENT=external-llm-quiesced

# ── External LLM endpoint ─────────────────────────────────────────────────
# Admin Settings can explicitly save changed safe formatter fields from these
# environment defaults. Model and temperature changes apply live. Restart the app
# after changing provider, host or effective authentication. Both providers accept a
# write-only Bearer key in Settings. Test the saved connection to list model IDs.
LLM__PROVIDER=ollama
# Docker host gateway; for a bare host process use http://127.0.0.1:11434.
LLM__HOST=http://host.docker.internal:11434
# Set the exact installed model ID. Direct vision needs image input capability;
# OCR uses an eligible text formatter. Leave this commented to preserve a saved
# choice on an existing installation. Fresh config needs an explicit model.
# LLM__MODEL_NAME=your-installed-model-id
LLM__TEMPERATURE=0.7
# Formatter output budget, independent of the fixed 4096 OCR tokens and model context capacity.
LLM__MAX_OUTPUT_TOKENS=32768
# Complete receipt extraction deadline, including JSON repair (seconds; maximum 600).
# LLM__ANALYSIS_TIMEOUT_SECONDS=600
# Legacy OpenAI-compatible provider key. For an Ollama endpoint that requires
# a Bearer token, save its key in Settings. Local Ollama normally needs no key.
LLM__API_KEY=none
# For an OpenAI-compatible backend, replace the provider and endpoint and set
# the exact installed model ID. Make one assignment for each setting.
# See OPENAI_COMPATIBLE.md; managed shared-GPU OCR needs a dedicated llama.cpp router.
# LLM__PROVIDER=openai
# LLM__HOST=http://host.docker.internal:8083/v1
# LLM__MODEL_NAME=receipt-formatter
# MODEL_LIFECYCLE defaults to none; only OpenAI uses this option.
# LLM__MODEL_LIFECYCLE=llamacpp
# Declare only known image-capable IDs with absent capability metadata:
# LLM__VISION_MODEL_IDS=["receipt-vision"]

# ── PostgreSQL ─────────────────────────────────────────────────────────────
PG__USER=vision_bill
PG__PASSWORD=vision_bill
PG__DB=vision_bill
PG__HOST=localhost
# Base Compose sets host=db/port=5432 internally; it publishes no DB host port.
# Host-side runs need an explicitly reachable DB. See UPGRADE_AND_VERIFY.md.
PG__PORT=5432

# ── Authentication (multi-user) ────────────────────────────────────────────
# REQUIRED. Signs the stateless, HMAC session cookie. Use a long random string:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH__SECRET_KEY=

# Optional. Salts passwords before Argon2id hashing. When unset,
# AUTH__SECRET_KEY is used as the pepper, so a pepper is always in play.
# AUTH__PEPPER=

# First-boot admin, created idempotently only on a completely empty DB (and
# used to backfill legacy rows with no owner). Leave both unset to skip it and
# register ordinary users instead. Registration never creates an admin.
# Prepared bundles generate private bootstrap credentials automatically; this
# source template does not.
# AUTH__BOOTSTRAP_USERNAME=admin
# AUTH__BOOTSTRAP_PASSWORD=

# Self-service registration from the login page (default: true). Set false to
# lock the app down to pre-provisioned accounts.
# AUTH__ALLOW_REGISTRATION=true

# When true, admins can view and edit every user's receipts and images
# (default: false — an admin sees only their own data).
# AUTH__ADMIN_CAN_SEE_ALL=false

# Set true when serving over HTTPS so the session cookie gets the Secure flag
# (default: false).
# AUTH__SESSION_SECURE=false

# Rarely changed (defaults shown):
# AUTH__SESSION_COOKIE_NAME=vb_session
# AUTH__SESSION_MAX_AGE_SECONDS=1209600

# Native build/qualification inputs (not application settings): select one overlay.
# No board is qualified by these example values. See paddleocr-service/README.md.
# Local ROCm builds detect one GFX target. Set the board's actual target when needed.
# OCR_AMDGPU_TARGETS=gfx1100
# Positive integer overrides the CPU/memory-based local ROCm build job default.
# OCR_BUILD_JOBS=auto
# OCR_CUDA_DEVICE_ID=0
# OCR_CUDA_CHANNEL=cu129
# AMD WSL 2 selects a GPU by index. Native Linux selects its render node below.
# OCR_ROCM_DEVICE_ID=0
# OCR_RENDER_NODE=/dev/dri/renderD128
# OCR_RENDER_GID=109
# OCR_VIDEO_GID=44
# Source setup binds the approved model bundle to the raw OCI config and image ID.
# OCR_RELEASE_DIR=./server_data/ocr-release
# OCR_IMAGE_ID=sha256:<actual-image-config-digest>
# Alembic/entrypoint uses PG__*; MIGRATION_DATABASE_URL does not switch credentials.
