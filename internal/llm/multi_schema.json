{"$defs": {"DuplicateCandidate": {"properties": {"first_index": {"description": "Earlier line_items array index", "minimum": 0, "title": "First Index", "type": "integer"}, "second_index": {"description": "Repeated line_items array index", "minimum": 0, "title": "Second Index", "type": "integer"}}, "required": ["first_index", "second_index"], "title": "DuplicateCandidate", "type": "object"}, "SourceLineItem": {"properties": {"description": {"description": "Name of the purchased item", "title": "Description", "type": "string"}, "spending_category": {"default": "unknown", "description": "One spending category code", "enum": ["unknown", "other", "milk", "cheese", "yogurt", "eggs", "butter_spreads", "bread_bakery", "cereals", "pasta_rice_grains", "vegetables", "fruit", "meat", "fish", "ready_meals", "snacks_sweets", "coffee_tea", "water", "soft_drinks", "alcohol", "sauces_spices", "cleaning", "household", "personal_care", "pet", "health", "clothing", "electronics", "hardware", "restaurant", "fuel", "services", "deposit"], "title": "Spending Category", "type": "string"}, "quantity": {"description": "Quantity purchased", "exclusiveMinimum": 0, "title": "Quantity", "type": "number"}, "unit_price": {"anyOf": [{"type": "number"}, {"pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$", "type": "string"}], "description": "Price per unit", "title": "Unit Price"}, "total_price": {"anyOf": [{"type": "number"}, {"pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$", "type": "string"}], "description": "quantity * unit_price, line total", "title": "Total Price"}, "tags": {"description": "Short tags for the item. Prefer the tag list from the prompt; a single new suggested tag is allowed when nothing fits.", "items": {"type": "string"}, "title": "Tags", "type": "array"}, "source_image": {"description": "Zero-based input photo index", "minimum": 0, "title": "Source Image", "type": "integer"}}, "required": ["description", "quantity", "unit_price", "total_price", "source_image"], "title": "SourceLineItem", "type": "object"}, "TaxLine": {"properties": {"name": {"description": "e.g. 'VAT', 'Sales Tax', 'GST'", "title": "Name", "type": "string"}, "rate": {"anyOf": [{"type": "number"}, {"type": "null"}], "default": null, "description": "Tax rate as a decimal, e.g. 0.19 for 19%", "title": "Rate"}, "amount": {"anyOf": [{"minimum": 0.0, "type": "number"}, {"pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$", "type": "string"}], "description": "Tax amount charged", "title": "Amount"}}, "required": ["name", "amount"], "title": "TaxLine", "type": "object"}}, "properties": {"confidence": {"description": "from 0 - 100 as percentage, how sure are you in the presented data", "maximum": 100, "minimum": 0, "title": "Confidence", "type": "integer"}, "merchant_name": {"description": "Name of the store or vendor, taken from printed text on the receipt (header, footer, address, website) \u2014 never guessed from a logo", "title": "Merchant Name", "type": "string"}, "merchant_address": {"anyOf": [{"type": "string"}, {"type": "null"}], "default": null, "description": "Store address if printed on receipt", "title": "Merchant Address"}, "receipt_number": {"anyOf": [{"type": "string"}, {"type": "null"}], "default": null, "description": "Transaction/receipt ID", "title": "Receipt Number"}, "date": {"description": "Date of purchase, ISO format YYYY-MM-DD", "format": "date", "title": "Date", "type": "string"}, "time": {"anyOf": [{"type": "string"}, {"type": "null"}], "default": null, "description": "Time of purchase, HH:MM 24h format", "title": "Time"}, "currency": {"default": "EUR", "description": "ISO 4217 currency code, e.g. USD, EUR", "title": "Currency", "type": "string"}, "category": {"default": "other", "description": "Best-guess category for the whole purchase", "enum": ["grocery", "electronics", "clothing", "restaurant", "fuel", "pharmacy", "entertainment", "other"], "title": "Category", "type": "string"}, "line_items": {"items": {"$ref": "#/$defs/SourceLineItem"}, "title": "Line Items", "type": "array"}, "taxes": {"description": "Tax lines applied", "items": {"$ref": "#/$defs/TaxLine"}, "title": "Taxes", "type": "array"}, "subtotal": {"anyOf": [{"type": "number"}, {"pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$", "type": "string"}], "description": "Sum of line items before tax/discounts", "title": "Subtotal"}, "discount_total": {"anyOf": [{"minimum": 0.0, "type": "number"}, {"pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$", "type": "string"}], "default": "0", "description": "Total discounts applied", "title": "Discount Total"}, "tax_total": {"anyOf": [{"minimum": 0.0, "type": "number"}, {"pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$", "type": "string"}], "default": "0", "description": "Sum of all taxes", "title": "Tax Total"}, "tip": {"anyOf": [{"minimum": 0.0, "type": "number"}, {"pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$", "type": "string"}, {"type": "null"}], "default": null, "description": "Tip/gratuity if applicable", "title": "Tip"}, "total": {"anyOf": [{"type": "number"}, {"pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$", "type": "string"}], "description": "Final amount charged", "title": "Total"}, "payment_method": {"default": "unknown", "enum": ["cash", "credit_card", "debit_card", "mobile_payment", "check", "other", "unknown"], "title": "Payment Method", "type": "string"}, "duplicate_candidates": {"description": "Pairs of array indices showing the SAME printed row in adjacent photos", "items": {"$ref": "#/$defs/DuplicateCandidate"}, "title": "Duplicate Candidates", "type": "array"}}, "required": ["confidence", "merchant_name", "date", "line_items", "subtotal", "total", "duplicate_candidates"], "title": "MultiImageReceipt", "type": "object"}