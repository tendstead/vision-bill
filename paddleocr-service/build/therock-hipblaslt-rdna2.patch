+    -DHIPBLASLT_INSTALL_TENSILELITE_TEST_ARTIFACTS=${_hipblaslt_tests}
     -DROCISA_USE_STABLE_ABI=ON
-    -DHIPBLASLT_ENABLE_ROCROLLER=${_enable_rocRoller}
+    -DHIPBLASLT_ENABLE_ROCROLLER=${_hipblaslt_rocroller}
+    ${_hipblaslt_host_args}
