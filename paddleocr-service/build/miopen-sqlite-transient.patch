+// SQLite's SQLITE_TRANSIENT macro uses a C-style cast. The -1 destructor
+// sentinel tells SQLite to copy text and blob bytes before bind returns.
+static sqlite3_destructor_type TransientDestructor()
+{
+    return reinterpret_cast<sqlite3_destructor_type>(-1);
+}
